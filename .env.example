DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
# DATABASE_URL=sqlite:///db.sqlite3
GOLD_DATABASE_URL=postgres://localhost:5432/gold
# Local Ollama used for the RAG chatbot (free, no API key). Defaults shown:
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# If GROQ_API_KEY is set below, the chatbot uses Groq instead of Ollama
# (get a free key at https://console.groq.com -> API Keys). Leave unset to
# keep using local Ollama.
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# llama-3.3-70b-versatile (used originally) was decommissioned by Groq at
# some point after this was set up -- calls to it now 404. Run
# `curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"`
# to see what's currently live before assuming this value still exists.
# If GEMINI_API_KEY is set, it takes priority over both Groq and Ollama
# (get a free key at https://aistudio.google.com/apikey). Added as a
# second option after Groq's free-tier 100K-tokens/day cap got repeatedly
# exhausted. gemini-flash-latest is a "thinking" model whose internal
# reasoning tokens count against max_tokens, so it needs a higher budget
# than Groq/Ollama do (see apps/chatbot/rag.py's _call_gemini()).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Redis: response cache + per-provider usage tracking for the chatbot (see
# apps/chatbot/cache.py). Optional -- every cache/budget check fails open
# (behaves as if Redis isn't there) if this is unreachable.
REDIS_URL=redis://localhost:6379/0
